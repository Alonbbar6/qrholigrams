{
  "name": "bar-ar-gift",
  "version": "1.0.0",
  "private": true,
  "description": "Web AR 'gift on your table' experience — scan a QR code, tap, and an animated 3D gift appears through the phone camera. No app install.",
  "type": "module",
  "scripts": {
    "dev": "npx --yes serve . -l 5000",
    "qr": "node scripts/generate-qr.js",
    "table": "node scripts/generate-table.mjs",
    "drink": "node scripts/prep-drink.mjs",
    "compress": "echo 'Usage: npm run compress -- path/to/model.glb' && exit 1",
    "compress:glb": "npx --yes @gltf-transform/cli draco",
    "compress:textures": "npx --yes @gltf-transform/cli webp",
    "validate:glb": "npx --yes @gltf-transform/cli validate"
  },
  "devDependencies": {
    "canvas": "3.2.3",
    "mind-ar": "^1.2.5",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "canvas": "3.2.3"
  }
}
